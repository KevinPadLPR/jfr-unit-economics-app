# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# src/lib/db.ts always reads data/dev.sqlite at request time — these two are
# only used by scripts/build_dev_db.py, to pull master_lot_schedule /
# master_crop_schedule from Supabase when rebuilding that sqlite file. Same
# Supabase project (and same JFR_-prefixed names, to avoid colliding with
# this machine's Dagster orchestration) as
# Unit Economics Reporting/supabase_sync.py — see that project's
# "Guide - Supabase Setup for JFR Sync.md" for how to get these values.
JFR_SUPABASE_URL=
JFR_SUPABASE_SECRET_KEY=
