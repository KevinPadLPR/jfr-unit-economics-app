# Auth (client-side only -- useClientSession.ts/shared.ts): the client's own Supabase
# project (user_profiles / current_user_role(), see
# public/client-app/docs/security-model.md). Public anon/publishable key, safe in the
# browser -- same values already shipped inside public/client-app/index.html.
NEXT_PUBLIC_SUPABASE_URL=https://xpfmebdzcxorvwikfvtj.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only (src/lib/supabase/service.ts, used by every src/lib/data/*.ts query):
# bypasses RLS, so this must never reach a "use client" file or the browser bundle --
# NOT NEXT_PUBLIC_-prefixed on purpose. Same project as above, same secret/service_role
# key as Unit Economics Reporting/.env's JFR_UE_SUPABASE_SECRET_KEY -- see that
# project's "Guia - Migrar Database a Supabase del Cliente.md" for how to get it.
SUPABASE_SERVICE_ROLE_KEY=
